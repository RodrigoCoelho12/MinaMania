<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/keybinds.uss?fileID=7433441132597879392&amp;guid=bf255ff395432244e90f39fe03e3a399&amp;type=3#keybinds" />
    <engine:VisualElement name="Container" class="configs" style="flex-grow: 1; background-color: rgba(62, 75, 190, 0); background-image: url(&quot;project://database/Assets/UI/Textures/Icones/Pedra2.png?fileID=2800000&amp;guid=55a62d0ccc248bb44809c4590d3b230a&amp;type=3#Pedra2&quot;); background-size: 177% 275%;">
        <engine:VisualElement name="Head" style="flex-grow: 1; max-height: 300px; min-height: 300px; background-image: none; -unity-background-image-tint-color: rgb(243, 243, 243); background-size: 57% 129%; -unity-text-align: upper-right; top: 16px; left: 4px; width: 1271px; align-self: center;">
            <engine:Label text="Configurações" name="KeybindsLabel" style="font-size: 114px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Textures/UpheavalPro.ttf?fileID=12800000&amp;guid=d04e1d096650c62409fa7a864017261b&amp;type=3#UpheavalPro&quot;); color: rgb(210, 219, 226); position: absolute; left: 175px; top: 198px; align-items: stretch; justify-content: flex-start; align-self: auto; align-content: auto; text-overflow: clip; width: 876px;" />
        </engine:VisualElement>
        <engine:VisualElement name="Body" style="flex-grow: 1; flex-direction: column; width: 1274px; max-width: 1606px; min-width: 70px; height: 703px; justify-content: flex-start; align-self: center; max-height: 630px;">
            <engine:VisualElement name="Image" style="flex-grow: 1; -unity-text-align: upper-left; position: relative; justify-content: space-between; align-items: stretch; align-content: auto; align-self: auto; flex-direction: row; flex-wrap: nowrap;">
                <engine:VisualElement name="Keybinds1" style="flex-grow: 1; align-items: flex-end; justify-content: space-between; margin-left: 38px;">
                    <engine:VisualElement name="ButtonContainerFW" class="button-container">
                        <engine:Label text="     Andar para frente" />
                        <engine:Button text="W" name="ForwardKeyButton" />
                    </engine:VisualElement>
                    <engine:VisualElement name="ButtonContainerBW" class="button-container">
                        <engine:Label text="         Andar para tras" />
                        <engine:Button text="S" name="BackwardKeyButton" />
                    </engine:VisualElement>
                    <engine:VisualElement name="ButtonContainerRS" class="button-container">
                        <engine:Label text="   Andar para direita" />
                        <engine:Button text="D" name="RightKeyButton" />
                    </engine:VisualElement>
                    <engine:VisualElement name="ButtonContainerLS" class="button-container">
                        <engine:Label text="Andar para esquerda" />
                        <engine:Button text="A" name="LeftKeyButton" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="Keybinds2" style="flex-grow: 1; align-self: auto; justify-content: space-around; align-items: center; margin-right: 24px;">
                    <engine:VisualElement name="ButtonContainerPCKX" class="button-container">
                        <engine:Label text="Atauqe de Picareta" />
                        <engine:Button text="LeftClick" name="PickaxeKeyButton" style="font-size: 18px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="ButtonContainerWS" class="button-container">
                        <engine:Label text="      Ataque de Spray" />
                        <engine:Button text="RightClick" name="BombLaunchKeyButton" style="font-size: 18px; -unity-font-style: normal;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="ButtonContainerBMB" class="button-container">
                        <engine:Label text="      ATAQUE DE BOMBA" />
                        <engine:Button text="SPACEBAR" name="BombLaunchKeyButton" style="font-size: 21px; -unity-font-definition: url(&quot;project://database/Assets/UI/Textures/UpheavalPro.ttf?fileID=12800000&amp;guid=d04e1d096650c62409fa7a864017261b&amp;type=3#UpheavalPro&quot;); -unity-font-style: normal; color: rgb(31, 42, 99);" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="QuitButton" text="X" emoji-fallback-support="true" class="quit" style="top: 62px; width: 157px; height: 128px; left: 0; bottom: 82px; font-size: 151px; -unity-font-definition: url(&quot;project://database/Assets/UI/Textures/UpheavalPro.ttf?fileID=12800000&amp;guid=d04e1d096650c62409fa7a864017261b&amp;type=3#UpheavalPro&quot;); align-self: center; -unity-text-align: middle-center; white-space: nowrap; text-overflow: clip; background-image: none; background-color: rgba(255, 0, 0, 0); background-size: 100% 100%; justify-content: flex-start; align-content: center; color: rgb(255, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
